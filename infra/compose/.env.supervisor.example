# Copy to .env next to docker-compose.supervisor.yml on the Docker host that runs the bot
# computers. See docs/self-host-docker-computers.md#supervisor-on-another-host.
#
# The computers' own settings belong here, on the host that runs them: the image tags, the
# RAKAZO_COMPUTER_* ceilings, egress and DNS. The app host's .env names only the provider, this
# supervisor's origin, the shared token and its own app image tag.

# The one address the supervisor publishes on. Loopback is a local smoke test only: another
# machine cannot reach it. For a real deployment set the private address of the interface the API
# host reaches (for example 10.0.0.5), and reach it over an encrypted link (TLS, WireGuard, a
# tailnet): a private network keeps the port off the internet but does not encrypt it. Never 0.0.0.0.
SANDBOX_SUPERVISOR_BIND=127.0.0.1

# Shared with the API and worker host; the app host's .env carries the same value. Generate one
# value privately and copy it over an encrypted channel:
#   openssl rand -hex 32
# It must differ from BETTER_AUTH_SECRET and SCREEN_PROXY_SECRET.
SANDBOX_SUPERVISOR_TOKEN=

# Both sides must speak the same supervisor contract, so tag these to the release the API and
# worker run, or `local` for images built from the same commit (the default `latest` is a moving
# tag, and Compose only pulls a missing image; run `docker compose ... pull` then `up -d` to move).
RAKAZO_IMAGE_TAG=latest
RAKAZO_COMPUTER_IMAGE_TAG=latest
# Optional mirror or locally built computer image (the default is
# ghcr.io/elie222/rakazo/computer), for example rakazo/computer with tag local.
RAKAZO_COMPUTER_IMAGE=
# Optional app image mirror (the default is ghcr.io/elie222/rakazo/app).
RAKAZO_IMAGE=

# restricted refuses to start computers until restrict-computer-egress.sh is installed on this
# Docker host. Set open only when its network access is intended and the host is isolated.
SANDBOX_COMPUTER_EGRESS=restricted
# Required when this host's resolvers have private addresses; see the restricted-egress section.
SANDBOX_COMPUTER_DNS=

# Optional ceilings for every bot computer (2g / 2 CPUs / 2048 pids by default).
RAKAZO_COMPUTER_MEMORY=
RAKAZO_COMPUTER_CPUS=
RAKAZO_COMPUTER_PIDS_LIMIT=
